# ---- Core ----
# Local dev uses the docker-compose Postgres below. In production (Railway/Dokku),
# set DATABASE_URL to the managed Postgres connection string.
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/workshop

# Access code attendees must type (shown on a slide).
WORKSHOP_CODE=dokku2026

# HTTP basic auth for /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Signs CSRF tokens. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-not-secret-change-me

# ---- Workshop topology (shown to attendees on their personal page) ----
JUMP_HOST=workshop-jump
JUMP_PUBLIC_IP=203.0.113.10
BASE_DOMAIN=workshop.example.com

# ---- keyctl (how the app talks to the jump host) ----
# keyadmin user on the jump host whose authorized_keys forces workshop-keyctl.
KEYADMIN_USER=keyadmin
# Contents of the private key that authenticates to keyadmin@jump. Written to a
# temp file with mode 600 at startup. Leave empty in DRY_RUN.
KEYCTL_PRIVATE_KEY=
# Pinned jump-host host key line(s) for known_hosts. Never disable host checking.
KEYCTL_KNOWN_HOSTS=
# Seconds to wait for a keyctl call before failing the signup.
KEYCTL_TIMEOUT=20

# ---- Dry-run ----
# 1 = no infrastructure needed. keyctl calls are replaced with a local fake that
# reads/writes dryrun/vm_pool.json + dryrun/authorized.json. Use this on a laptop.
DRY_RUN=1

# ---- Limits ----
# Max signup POSTs per client IP per minute.
RATE_LIMIT_PER_MIN=10
