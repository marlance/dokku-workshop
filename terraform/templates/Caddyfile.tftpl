# Generated by Terraform — do not edit on the host; change the template and re-apply.
#
# HTTP only (http:// prefix disables Caddy's automatic HTTPS). The Host header is
# rewritten to the dokku vhost so the attendee just runs `dokku apps:create myapp`
# with no domain commands and it is reachable at myapp-userNN.<base_domain>.
# To add TLS later: drop the http:// prefix, open 443 on the jump firewall.

%{ for user, ip in vms ~}
http://myapp-${user}.${base_domain} {
	reverse_proxy ${ip}:80 {
		header_up Host myapp.${base_domain}
	}
}

http://myapp-k8s-${user}.${base_domain} {
	reverse_proxy ${ip}:80 {
		header_up Host myapp-k8s.${base_domain}
	}
}

%{ endfor ~}
