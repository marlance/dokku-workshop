# Generated by Terraform — do not edit on the host; change the template and re-apply.
#
# HTTP only (http:// prefix disables Caddy's automatic HTTPS). One wildcard site:
# <app>-userNN.<base_domain> goes to that user's VM with the Host rewritten to
# <app>.<base_domain>, which is the vhost Dokku gives every app by default.
# So any app name works and attendees run no domain commands. (If an attendee
# runs `domains:set`, their app stops matching — the cheat sheet doesn't ask.)
# To add TLS later: drop the http:// prefix, open 443 on the jump firewall.

http://*.${base_domain} {
%{ for user, ip in vms ~}
	@${user} header_regexp ${user} Host (?i)^([a-z0-9][a-z0-9-]*)-${user}\.${replace(base_domain, ".", "\\.")}$
	handle @${user} {
		reverse_proxy ${ip}:80 {
			header_up Host {re.${user}.1}.${base_domain}
		}
	}

%{ endfor ~}
	handle {
		respond "No app at this address. Use http://<app>-userNN.${base_domain}" 404
	}
}
